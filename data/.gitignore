# Ignore all data artifacts — large binary files should not be in git
# Raw HDF5 strain data downloads
raw/
*.hdf5
*.h5
*.hdf

# Generated spectrograms (PNG + PyTorch tensors)
spectrograms/
*.pt
*.png

# Latent embedding vectors from encoder
embeddings/
*.npy
*.npz

# Keep this .gitignore
!.gitignore

# Data — never commit
data/raw/
data/spectrograms/
data/embeddings/
data/clusters/
data/reference/

# Results — commit only final images
results/figures/**
!results/figures/*.png
!results/figures/clusters/*.png

docs/